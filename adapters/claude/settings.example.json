{
  "_note": "OPTIONAL Claude Code adapter. Mirrors src/policy/permissions.mjs; keep in sync — the core policy engine is authoritative.",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Read(**/.env.production)",
      "Read(**/.ssh/**)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Edit(**/.state/assurance/**)",
      "Write(**/.state/assurance/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm test:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/adapters/claude/hooks/protect-sensitive.mjs\""
          }
        ]
      }
    ]
  }
}
