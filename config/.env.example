# Local OmniRoute quickstart only.
#
# WARNING: on the local quickstart endpoint, ANY non-empty bearer value is
# accepted — a "dummy-key" is NOT authentication. Keep the endpoint bound to
# loopback (127.0.0.1) only. Never expose an OmniRoute endpoint beyond
# loopback with a dummy key; configure a real endpoint key and network policy
# for any shared or remote deployment. See docs/THREAT-MODEL.md §18.
OMNIROUTE_API_KEY=dummy-key
